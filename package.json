{
  "name": "rin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@niwa-labs/agent": "link:../niwa/packages/agent",
    "@niwa-labs/commitments": "link:../plugins/packages/commitments",
    "@niwa-labs/core": "link:../niwa/packages/core",
    "@niwa-labs/delegate": "link:../plugins/packages/delegate",
    "@niwa-labs/digest": "link:../niwa/packages/digest",
    "@niwa-labs/git": "link:../niwa/packages/git",
    "@niwa-labs/harness": "link:../niwa/packages/harness",
    "@niwa-labs/history": "link:../niwa/packages/history",
    "@niwa-labs/memory": "link:../plugins/packages/memory",
    "@niwa-labs/messages": "link:../niwa/packages/messages",
    "@niwa-labs/plugin": "link:../niwa/packages/plugin",
    "@niwa-labs/requests": "link:../niwa/packages/requests",
    "@niwa-labs/sandbox": "link:../niwa/packages/sandbox",
    "@niwa-labs/sessions": "link:../niwa/packages/sessions",
    "@niwa-labs/tasks": "link:../niwa/packages/tasks"
  }
}
